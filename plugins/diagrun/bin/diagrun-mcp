#!/bin/sh
# MCP stdio entry for Agent Plugins / Pi / any MCP client.
set -eu
PLUGIN_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$PLUGIN_ROOT/../.." && pwd)"
PYTHON="${DIAGRUN_PYTHON:-python3}"
if "$PYTHON" -c "import diagrun" >/dev/null 2>&1; then
  exec "$PYTHON" -m diagrun mcp
fi
export PYTHONPATH="$REPO_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" -m diagrun mcp
